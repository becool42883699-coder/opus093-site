# OS / エディタ / ローカル設定
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json

# 秘密情報・ローカル環境（example は管理対象に残す）
.env
.env.*
!.env.example
!.env.*.example

# 依存関係・Next.js / TypeScript の生成物
node_modules/
/.next/
/out/
/dist/
/build/
/coverage/
.turbo/
.vercel/
*.tsbuildinfo
*.log

# 検証・ビルド・一時ファイル（スクリーンショット等・リポジトリには入れない）
artifacts/
scratch/
.tmp-verify/
tmp/
temp/
.cache/

# migiwa: ビルドの中間生成物（copy.json から作り直せる）
public/migiwa/.content.html
public/migiwa/.works.html

# Graft のビルド生成物（graft build で再生成できる）
graft/.cache/
/graft/
